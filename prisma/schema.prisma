// DemoHub schema — interactive product demo platform (SQLite-compatible)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Users & Auth ───────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  workspace     Workspace? @relation("Owner")
  memberships   Membership[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Workspaces & Billing ───────────────────────────────────────

model Workspace {
  id                   String    @id @default(cuid())
  name                 String    @default("My Workspace")
  slug                 String    @unique
  ownerId              String    @unique
  owner                User      @relation("Owner", fields: [ownerId], references: [id], onDelete: Cascade)
  plan                 String    @default("free")
  stripeCustomerId     String?
  stripeSubscriptionId String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  members    Membership[]
  demos      Demo[]
  demoAgents DemoAgent[]
}

model Membership {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  role        String   @default("member")
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
}

// ─── Demos (Interactive Walkthroughs) ───────────────────────────

model Demo {
  id             String   @id @default(cuid())
  workspaceId    String
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  title          String
  description    String?
  type           String   @default("interactive")
  shareToken     String   @unique @default(uuid())
  isPublished    Boolean  @default(false)
  requireEmail   Boolean  @default(false)
  password       String?
  // Supademo-style recorder fields
  status         String   @default("draft")   // draft | recording | ready
  stepDurationSec Int     @default(3)
  theme          String?  // JSON
  // Voice clone
  clonedVoiceId   String?  // ElevenLabs voice ID for this demo
  clonedVoiceName String?  // human-readable name
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  steps     DemoStep[]
  views     DemoView[]
  leads     Lead[]
  agent     DemoAgent?
}

model DemoStep {
  id           String   @id @default(cuid())
  demoId       String
  demo         Demo     @relation(fields: [demoId], references: [id], onDelete: Cascade)
  order        Int
  title        String?
  description  String?
  snapshot     String?
  hotspots     String
  videoUrl     String?
  duration     Int?
  // Supademo-style recorder / editor fields
  type         String   @default("click")  // click | manual | chapter
  pageUrl      String?
  pageTitle    String?
  clickX       Float?
  clickY       Float?
  elementJson  String?  // JSON
  callout      String?  // JSON: {text,x,y,width,placement,fontFamily,fontSize,bold,italic,textColor,bgColor,showArrow,emoji}
  hotspot      String?  // JSON: {x,y,w,h,shape}
  blurs        String?  // JSON array of {x,y,w,h}
  annotations  String?  // JSON array
  crop         String?  // JSON: {x,y,w,h}
  background   String?  // JSON
  aiStatus     String   @default("pending")  // pending | done | failed
  screenshotUrl String? // path to file
  // Voice / voiceover fields
  voiceScript   String?  // text the voice should speak for this step
  voiceAudioUrl String?  // URL to generated MP3 file
  voiceStatus   String   @default("none")  // none | generating | done | failed
  // AI Avatar video fields
  avatarImageUrl  String?  // URL of the avatar face image uploaded by user
  avatarVideoUrl  String?  // URL of the final D-ID talking-head video
  avatarStatus    String   @default("none")  // none | generating | done | failed
  avatarTalkId    String?  // D-ID talk job ID for polling
  createdAt    DateTime @default(now())

  @@index([demoId, order])
}

// ─── Recorder Sessions (Playwright + WebSocket) ─────────────────

model RecorderSession {
  id          String   @id @default(cuid())
  demoId      String   @unique
  userId      String
  status      String   @default("starting") // starting | recording | paused | stopping | closed
  url         String
  viewport    String   @default("1280x720")
  stepCount   Int      @default(0)
  token       String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─── Analytics ──────────────────────────────────────────────────

model DemoView {
  id              String   @id @default(cuid())
  demoId          String
  demo            Demo     @relation(fields: [demoId], references: [id], onDelete: Cascade)
  userId          String?
  viewerEmail     String?
  viewerCompany   String?
  ipAddress       String?
  userAgent       String?
  completed       Boolean  @default(false)
  stepsViewed     Int      @default(0)
  duration        Int      @default(0)
  createdAt       DateTime @default(now())

  @@index([demoId, createdAt])
  @@index([userId])
}

// ─── Lead Capture ───────────────────────────────────────────────

model Lead {
  id        String   @id @default(cuid())
  demoId    String
  demo      Demo     @relation(fields: [demoId], references: [id], onDelete: Cascade)
  email     String
  name      String?
  company   String?
  phone     String?
  notes     String?
  source    String?
  createdAt DateTime @default(now())

  @@index([demoId, createdAt])
  @@index([email])
}

// ─── AI Demo Agent ──────────────────────────────────────────────

model DemoAgent {
  id           String   @id @default(cuid())
  workspaceId  String
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  demoId       String   @unique
  demo         Demo     @relation(fields: [demoId], references: [id], onDelete: Cascade)
  name         String   @default("Demo Agent")
  instructions String?
  isActive     Boolean  @default(true)
  creditsUsed  Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  conversations AgentConversation[]

  @@index([workspaceId])
}

model AgentConversation {
  id        String    @id @default(cuid())
  agentId   String
  agent     DemoAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  sessionId String
  role      String
  content   String
  credits   Int       @default(1)
  createdAt DateTime  @default(now())

  @@index([agentId, sessionId])
}
