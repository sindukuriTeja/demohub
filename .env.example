# ─── Database ────────────────────────────────────────────────────────────────
# SQLite (default, for local/dev):
DATABASE_URL="file:./prisma/dev.db"
# Postgres (production, set when using docker compose --profile postgres):
# DATABASE_URL="postgresql://demohub:demohub_secret@demohub-db:5432/demohub?schema=public"

# ─── NextAuth ────────────────────────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-in-production"

# ─── AI Demo Agent ───────────────────────────────────────────────────────────
# Use ONE of the following providers. Both are OpenAI-compatible and use the
# same SDK — just set the key and (for Groq) the base URL + model.

# Option 1: Groq (RECOMMENDED — free, no credit card, fastest)
# Sign up: https://console.groq.com → create API key at https://console.groq.com/keys
GROQ_API_KEY=""
OPENAI_BASE_URL="https://api.groq.com/openai/v1"
AI_MODEL="llama-3.3-70b-versatile"

# Option 2: OpenAI (paid, but new accounts get small free credit)
# OPENAI_API_KEY=""
# OPENAI_BASE_URL="https://api.openai.com/v1"
# AI_MODEL="gpt-4o-mini"

# ─── Stripe (for billing - optional for MVP) ─────────────────────────────────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# ─── Postgres (only used with docker compose --profile postgres) ─────────────
POSTGRES_USER=demohub
POSTGRES_PASSWORD=demohub_secret
POSTGRES_DB=demohub
